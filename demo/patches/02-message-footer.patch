diff --git a/packages/chat/src/ui/renderers/MessageFooterOutlet.vue b/packages/chat/src/ui/renderers/MessageFooterOutlet.vue
new file mode 100644
--- /dev/null
+++ b/packages/chat/src/ui/renderers/MessageFooterOutlet.vue
@@ -0,0 +1,28 @@
+<script setup lang="ts">
+import { ref, watchEffect } from 'vue'
+import type { ChatBubbleContentFooterSlotProps, ChatMessageFooterRenderer } from '../../types'
+
+const props = defineProps<{
+  context: ChatBubbleContentFooterSlotProps
+  renderer: ChatMessageFooterRenderer
+}>()
+const outlet = ref<HTMLElement | null>(null)
+
+watchEffect((onCleanup) => {
+  const host = outlet.value
+  if (!host) return
+
+  const controller = new AbortController()
+  onCleanup(() => {
+    controller.abort()
+    host.replaceChildren()
+  })
+
+  const node = props.renderer(props.context, controller.signal)
+  if (node) host.append(node)
+}, { flush: 'post' })
+</script>
+
+<template>
+  <div ref="outlet" />
+</template>
