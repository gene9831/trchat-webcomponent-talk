{
  "name": "trchat-webcomponent-talk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm run build:demo && vitepress dev docs",
    "build": "pnpm run build:demo && vitepress build docs",
    "build:demo": "node demo/prepare-renderer.mjs && vite build --config demo/vite.config.mjs && vite build --config demo/vite.config.mjs --mode renderer-before && vite build --config demo/vite.config.mjs --mode renderer-after",
    "preview": "vitepress preview docs",
    "fetch:source": "node demo/prepare-renderer.mjs --fetch"
  },
  "dependencies": {
    "@angular/common": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentiny/tiny-robot": "1.0.0",
    "@opentiny/tiny-robot-chat": "1.0.0",
    "@opentiny/tiny-robot-kit": "1.0.0",
    "@opentiny/tiny-robot-svgs": "1.0.0",
    "@vueuse/core": "13.9.0",
    "dompurify": "^3.3.1",
    "markdown-it": "^14.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "less": "4.9.1",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitepress": "1.6.4"
  }
}
